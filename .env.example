# ── MUN PARFUM POS — konfigurasi frontend ─────────────────────────────
# Salin ke `.env.local` lalu isi nilainya dari Supabase Dashboard →
# Project Settings → API.
#
# PENTING: hanya anon (public) key yang boleh di sini.
# JANGAN PERNAH memasukkan service_role key ke file frontend.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Domain email sintetis untuk akun karyawan yang login dengan username
# (contoh: username "nawir08" → nawir08@staff.munparfum.local).
VITE_STAFF_EMAIL_DOMAIN=staff.munparfum.local

# ── Khusus pengujian database lokal (tidak dipakai frontend) ─────────
# DATABASE_URL=postgres://postgres@localhost:54329/postgres
